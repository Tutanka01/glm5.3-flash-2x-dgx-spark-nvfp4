# Concurrent serving: 8 parallel requests plus a wider chunked prefill.
# Aggressive profile: if the memory guard trips or prefill OOMs, fall back to
# 32k-batch4 or set MAX_NUM_BATCHED_TOKENS back to 4096.
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=8
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=0
