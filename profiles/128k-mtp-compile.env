# Decode ablation: MTP5 + CUDA graphs + torch.compile at bs=1. SGLang documents
# compile support for the EAGLE/NEXTN speculative path, but benefit varies by
# model and hardware. Expect a longer first boot/capture; keep only a measured
# gain with identical smoke/tool behavior.
# Bench with: ./bench-glm53.py --runs 3
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=1
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=5
ENABLE_TORCH_COMPILE=1
TORCH_COMPILE_MAX_BS=1
