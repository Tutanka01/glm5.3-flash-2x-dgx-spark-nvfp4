# Decode ablation: MTP5 + CUDA graphs at bs=1 with pure tensor parallel MoE.
# EP=1 replaces the EP=2 all-to-all pattern with TP collectives. The result is
# numerically the same model; keep only if smoke/tool tests pass and median
# decode beats 128k-batch4-mtp in mono-stream mode.
# Bench with: ./bench-glm53.py --runs 3
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=1
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=5
EP_SIZE=1
