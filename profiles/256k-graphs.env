# Experimental ceiling probe with CUDA graphs enabled at 262 144 tokens.
# The eager 256k profile leaves the graph replay unused; single-sequence
# capture (bs=1) is small and restores the decode speed lost to eager mode.
# If graph capture OOMs at this context, lower MEM_FRACTION_STATIC to 0.88 or
# fall back to the eager 256k profile.
# Bench with: ./bench-glm53.py --runs 3
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=1
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=0
