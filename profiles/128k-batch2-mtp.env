# Combined: 131 072 tokens, 2 concurrent requests, MTP (NEXTN) with 5 steps.
# Middle ground between interactive mono-stream (29 tok/s with MTP) and the
# batched TTFT collapse at concurrency 4 (p99 45 s, docs/BENCHMARKS.md).
# Lossless for quality: the target model verifies every drafted token.
# Bench with: ./bench-glm53.py --runs 3 --concurrency 2
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=2
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=5
