# Combined: 131 072 tokens, 4 concurrent requests, MTP (NEXTN) with 3 steps.
# Hypothesis to measure: 5 speculative steps double mono-stream decode but
# collapse batched TTFT (p99 45 s at concurrency 4, docs/BENCHMARKS.md) because
# prefill admission waits at speculative batch boundaries. Three steps shorten
# those boundaries. Speculative verification is lossless: quality is unchanged.
# Bench with: ./bench-glm53.py --runs 3 --concurrency 4
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=4
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=3
