# Quarantined 524 288-token experiment: MTP stays enabled while CUDA graph
# replay is disabled. No 512k cold prompt has been validated on this TP2/GB10
# recipe; disabling graphs only removes one known failure mode.
# Validate a real cold prompt, not only server startup:
#   ./bench-long-context.py --allow-unsafe-profile --target-tokens 480000 --cold --label 512k-mtp-eager
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=1
DISABLE_CUDA_GRAPH=1
MTP_NUM_TOKENS=5
PROFILE_TIER=quarantined
