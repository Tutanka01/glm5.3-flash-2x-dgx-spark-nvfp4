# Safe 524 288-token capability profile: MTP stays enabled but all CUDA graph
# replay is disabled. This is the fail-safe for cold prompts above 262 144
# tokens while SGLang issue #36550 remains open. It should preserve much of the
# speculative decode gain, but will be slower than captured decode.
# Validate a real cold prompt, not only server startup:
#   ./bench-long-context.py --target-tokens 480000 --cold --label 512k-mtp-eager
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=1
DISABLE_CUDA_GRAPH=1
MTP_NUM_TOKENS=5
