# Combined: 131 072 tokens, 4 concurrent requests, pure tensor parallel.
# EP_SIZE=1 shards every expert across the two ranks (one all-reduce per MoE
# layer) instead of expert-parallel all-to-all over RoCE. Outputs are
# mathematically identical; only the communication pattern changes. Benchmark
# both arrangements and keep the faster; EP=2 remains the audited default.
# Bench with: ./bench-glm53.py --runs 3 --concurrency 4
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=4
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=0
EP_SIZE=1
