# Combined: 131 072 tokens, 4 concurrent requests, chunked prefill of 8192.
# Doubles the prefill chunk so long-context bursts drain in half the scheduling
# rounds; targets the aggregate wall time (144.9 s at concurrency 4 in
# docs/BENCHMARKS.md). Costs a larger activation workspace; watch the memory
# guard. Keep MTP off here: this profile targets sub-agent bursts.
# Bench with: ./bench-glm53.py --runs 3 --concurrency 4
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=4
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=0
