# Reliability-first 240k cold-prompt profile for the 128 GiB unified-memory
# nodes. Keep speculative decoding and CUDA graphs out of this capacity test,
# halve the prefill workspace, and retain extra dynamic-memory headroom. The
# faster 256k-graphs/256k-mtp profiles are only short-decode experiments.
# Canonical validation:
#   ./bench-long-context.py --target-tokens 240000 --cold --label 256k-safe
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=1024
MEM_FRACTION_STATIC=0.88
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=1
DISABLE_CUDA_GRAPH=1
MTP_NUM_TOKENS=0
