# Combined: 131 072 tokens, 4 concurrent requests, MTP (NEXTN) speculation.
# Measured on the reference 2x GB10 fabric (2026-08-27, docs/BENCHMARKS.md):
# mono-flux decode x2.0 (14.5 -> 29.0 tok/s) but batched TTFT collapses
# (p99 45 s at concurrency 4). Best for interactive single-stream use.
# For sub-agent bursts without MTP, prefer 128k-batch4.
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=4
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=5
