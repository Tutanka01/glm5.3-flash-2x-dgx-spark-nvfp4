# Combined: 131 072 tokens, 4 concurrent requests, MTP (NEXTN) speculation.
# Only run after 32k-mtp and 128k-batch4 are both validated on your fabric:
# this stacks the two least-tested knobs. If boot OOMs or output degrades,
# fall back to 128k-batch4 (no MTP) or 32k-mtp (single request).
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=4
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=5
