#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="${GLM53_MOCK_STATE:?}"
ALL_ARGS=" $* "
case "$ALL_ARGS" in
  *" compose version "*) printf 'Docker Compose mock\n' ;;
  *" compose "*" config "*) ;;
  *" image inspect "*) ;;
  *" inspect -f "*".State.Running"*) printf 'true\n' ;;
  *" inspect -f "*".Config.Env"*)
    printf '%s\n' \
      'GLM53_PROFILE_NAME=32k' \
      'MAX_MODEL_LEN=32768' \
      'MAX_NUM_SEQS=1' \
      'DISABLE_CUDA_GRAPH=0' \
      'MTP_NUM_TOKENS=0'
    ;;
  *" compose "*" ps -q "*)
    [ -f "$STATE_DIR/head" ] && printf 'head-container\n'
    ;;
  *" compose "*" up -d "*) touch "$STATE_DIR/head" ;;
  *" compose "*" stop "*|*" compose "*" down "*) rm -f "$STATE_DIR/head" ;;
  *" compose "*" logs "*) printf 'mock head logs\n' ;;
  *" run "*) ;;
  *" pull "*) ;;
  *) ;;
esac
