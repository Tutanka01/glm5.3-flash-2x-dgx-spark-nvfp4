{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-glm53/glm-5.3-flash-nvfp4",
  "provider": {
    "local-glm53": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM-5.3-Flash NVFP4 (2x GB10)",
      "options": {
        "baseURL": "http://10.10.10.1:8888/v1",
        "apiKey": "{env:GLM53_API_KEY}"
      },
      "models": {
        "glm-5.3-flash-nvfp4": {
          "name": "GLM-5.3-Flash NVFP4",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          },
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}

