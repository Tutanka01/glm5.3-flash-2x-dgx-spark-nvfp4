{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-glm53/glm53",
  "providers": {
    "local-glm53": {
      "name": "GLM-5.3-Flash NVFP4 (2x GB10)",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://10.10.10.1:8888/v1",
        "apiKey": "{env:GLM53_API_KEY}"
      },
      "models": {
        "glm53": {
          "modelID": "glm-5.3-flash-nvfp4",
          "name": "GLM-5.3-Flash NVFP4",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          // Limites calibrées pour le profil par défaut ./start-glm53.sh 256k-dflash2-eager
          // (pool KV ≈ 210K tokens, 200 012 tokens froids validés le 2026-08-28).
          // Autres profils : 245760 pour `256k` (240 008 validés), 32768 pour `32k`.
          "limit": {
            "context": 196608,
            "output": 8192
          }
        }
      }
    }
  }
}
