# Fast 524 288-token experiment: MTP + decode CUDA graphs + two-rank context
# parallelism for DSA prefill. CP keeps a 480k cold prompt near 240k tokens per
# rank, below the 262,144-token graph-replay boundary in SGLang issue #36550.
# Start at 480k actual prompt tokens; do not claim 512k until the needle test
# passes cold and the API remains healthy afterward.
#   ./bench-long-context.py --allow-unsafe-profile --target-tokens 480000 --cold --label 512k-mtp-cp
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=1
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=5
PROFILE_TIER=quarantined
ENABLE_PREFILL_CP=1
ATTN_CP_SIZE=2
CP_STRATEGY=interleave
