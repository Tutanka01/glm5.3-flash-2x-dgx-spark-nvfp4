# Strictest KV-quality probe above 256k: BF16 KV cache, MTP, decode graphs and
# two-rank DSA prefill CP. BF16 avoids the additional runtime KV quantization of
# the normal fp8_e4m3 profiles. The NVFP4 model weights remain the project
# baseline, so this is "no further KV loss" rather than BF16-model equivalence.
#   ./bench-long-context.py --allow-unsafe-profile --target-tokens 360000 --cold --label 384k-quality
MAX_MODEL_LEN=393216
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=bfloat16
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=1
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=5
PROFILE_TIER=quarantined
ENABLE_PREFILL_CP=1
ATTN_CP_SIZE=2
CP_STRATEGY=interleave
