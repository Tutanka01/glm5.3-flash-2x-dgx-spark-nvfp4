# DFlash2 concurrency/graph stress lane for C1/C2/C4/C5/C6 sweeps. Capturing
# through batch 8 needs 40 target Mamba slots and a larger static allocation.
# 2026-08-28: MEM_FRACTION_STATIC=0.92 never reached readiness. The head
# startup guard tripped (MemAvailable 6032 MiB < 6144 MiB floor, OOMKilled=false,
# exit 137) during the draft CUDA graph capture at bs=8, with only 5.81 GB of
# GPU headroom left on the head (weights 91.0 GB + draft 1.65 GB + Mamba 40
# slots ~4.1 GB + KV pools ~4.8 GB). Derated to 0.90 (~+2.4 GiB headroom,
# same reserve as the proven 128k-dflash2-c4 lane); if the guard trips again,
# fall back to 0.88 and archive with collect-glm53-report.sh first.
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=8
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=0
SPECULATIVE_ALGORITHM=DFLASH
DFLASH_DRAFT_MODEL_PATH=/cache/huggingface/hub/models--incoai--GLM-5.3-Flash-DFlash2/snapshots/7d74cdd881ed7e32c31175984a67823127b66cfe
DFLASH_DRAFT_ATTENTION_BACKEND=fa4
DFLASH_DRAFT_WINDOW_SIZE=2048
MAMBA_SSM_DTYPE=bfloat16
MAX_MAMBA_CACHE_SIZE=40
PROFILE_RUNTIME_IMAGE=glm53-sglang-dflash2:2d4b6ac-sm121
PROFILE_TIER=experimental
