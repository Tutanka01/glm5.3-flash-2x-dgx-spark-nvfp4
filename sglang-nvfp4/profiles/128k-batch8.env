# Long context (131 072 tokens) with 8 concurrent requests.
# Aggressive: most workloads never fill 8 x 131k of KV at once, but the CUDA
# graph capture at bs=8 costs extra memory. If the boot OOMs or the memory
# guard trips, fall back to 128k-batch4 or 32k-batch8.
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=4096
MEM_FRACTION_STATIC=0.90
KV_CACHE_DTYPE=fp8_e4m3
MOE_BACKEND=flashinfer_cutlass
DSA_PREFILL_BACKEND=flashinfer_sparse_mla
DSA_DECODE_BACKEND=flashinfer_sparse_mla
CUDA_GRAPH_MAX_BS=8
DISABLE_CUDA_GRAPH=0
MTP_NUM_TOKENS=0
