# GLM-5.3-Flash NVFP4 on 2 x DGX Spark / PGX (GB10), TP=2.
# Copy this file to .env.glm53 on the HEAD node and edit every REQUIRED value.
# The launch scripts copy the resulting file to the worker with mode 0600.

# -----------------------------------------------------------------------------
# Cluster (REQUIRED)
# -----------------------------------------------------------------------------
# SSH destination used from the head node (hostname, IP, or user@host).
WORKER_HOST=worker-host-or-management-ip
# Absolute deployment path on the worker. Do not use ~ or spaces.
WORKER_DIR=/home/USER/glm5.3-flash-2x-dgx-spark-nvfp4
# Optional SSH settings.
SSH_PORT=22
# SSH_IDENTITY_FILE=/home/USER/.ssh/id_ed25519

# RoCE IP of rank 0. This is also the torch distributed master by default.
MASTER_ADDR=10.10.10.1
MASTER_PORT=25000
VLLM_HOST_IP=10.10.10.1
WORKER_VLLM_HOST_IP=10.10.10.2

# -----------------------------------------------------------------------------
# RoCE / NCCL fabric (REQUIRED)
# Reuse the exact known-good values from an existing 2-node Spark recipe.
# Interface and HCA names often differ between the two machines.
# -----------------------------------------------------------------------------
NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_GID_INDEX=5

# Worker overrides. Leave blank only when both nodes really use the same names.
WORKER_NCCL_IB_HCA=
WORKER_NCCL_SOCKET_IFNAME=
WORKER_TP_SOCKET_IFNAME=
WORKER_GLOO_SOCKET_IFNAME=
WORKER_NCCL_IB_GID_INDEX=

NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN

# -----------------------------------------------------------------------------
# Checkpoint and immutable runtime pins (verified 2026-08-26).
# This revision is the post-fix sync of the official corrected chat template.
# -----------------------------------------------------------------------------
MODEL_ID=LibertAIDAI/GLM-5.3-Flash-NVFP4
MODEL_REVISION=11d73216cd636238e82e1d77fe1042ffab36e7fa
SERVED_MODEL_NAME=glm-5.3-flash-nvfp4

# Dedicated ARM64/CUDA 13 image containing the in-flight glm5_next support.
# The digest is the active linux/arm64 image published with the tag below.
GLM53_VLLM_IMAGE=vllm/vllm-openai:glm53-flash-arm64-cu130@sha256:905c02933be6021301db2dc284e24e3727467aa3a0f63b41d609885778a07bce

# -----------------------------------------------------------------------------
# Caches / download
# Each TP rank needs a complete local copy of the ~181.3 GiB checkpoint.
# -----------------------------------------------------------------------------
HF_CACHE=${HOME}/.cache/huggingface
# Set explicitly when the worker uses another user or filesystem.
WORKER_HF_CACHE=
# The checkpoint is public. Only set a token if your environment requires one.
# HF_TOKEN=hf_xxx
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=1800
HF_HUB_ETAG_TIMEOUT=60
HF_DOWNLOAD_WORKERS=4

# -----------------------------------------------------------------------------
# Serving profile
# The positional argument to start/validate overrides GLM53_PROFILE.
# Available profiles: 32k, 64k, 128k, 256k, 32k-mtp, 32k-native.
# -----------------------------------------------------------------------------
GLM53_PROFILE=32k
VLLM_HOST=0.0.0.0
VLLM_PORT=8888
# Optional vLLM bearer token. Quote values containing shell-special characters.
# VLLM_API_KEY=change-me

# Leave enough unified memory for the OS. memswap_limit is set to the same value.
CONTAINER_MEMORY_LIMIT=112g
RESTART_POLICY=no
STOP_GRACE_PERIOD=30s

# Model init can take many minutes (download is deliberately forbidden at boot).
VLLM_ENGINE_READY_TIMEOUT_S=3600
START_WAIT_TIMEOUT=3600
START_WAIT_INTERVAL=15
START_SMOKE=1

# Host-side load guard. It stops only this recipe's local container if available
# RAM falls below the threshold before the API becomes healthy.
OOM_GUARD=1
OOM_GUARD_MIN_AVAILABLE_MB=6144
OOM_GUARD_TIMEOUT=3600

# Doctor thresholds. Set REQUIRE_SWAP_OFF=1 for a strict no-swap policy.
MIN_START_AVAILABLE_MB=100000
MIN_CACHE_FREE_GIB=205
REQUIRE_SWAP_OFF=0
ALLOW_UNSUPPORTED_PLATFORM=0
