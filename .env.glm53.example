# GLM-5.3-Flash NVFP4 on 2 x DGX Spark / PGX (GB10), TP=2.
# Copy this file to .env.glm53 on the HEAD node and edit every REQUIRED value.
# The launch scripts copy the resulting file to the worker with mode 0600.

# -----------------------------------------------------------------------------
# Cluster (REQUIRED)
# -----------------------------------------------------------------------------
# SSH destination used from the head node (hostname, IP, or user@host).
WORKER_HOST=worker-host-or-management-ip
# Absolute deployment path on the worker. Do not use ~ or spaces.
WORKER_DIR=/home/USER/glm5.3-flash-2x-dgx-spark-nvfp4
# Optional SSH settings.
SSH_PORT=22
# SSH_IDENTITY_FILE=/home/USER/.ssh/id_ed25519

# RoCE addresses used by SGLang, torch distributed, Gloo and NCCL.
HEAD_FABRIC_IP=10.10.10.1
WORKER_FABRIC_IP=10.10.10.2
MASTER_ADDR=10.10.10.1
MASTER_PORT=25000

# -----------------------------------------------------------------------------
# RoCE / NCCL fabric (REQUIRED)
# Reuse the exact known-good values from an existing 2-node Spark recipe.
# Interface and HCA names often differ between the two machines.
# -----------------------------------------------------------------------------
NCCL_IB_HCA=rocep1s0f1
NCCL_SOCKET_IFNAME=enp1s0f1np1
TP_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1

# Worker overrides. Leave blank only when both nodes really use the same names.
WORKER_NCCL_IB_HCA=
WORKER_NCCL_SOCKET_IFNAME=
WORKER_TP_SOCKET_IFNAME=
WORKER_GLOO_SOCKET_IFNAME=
WORKER_NCCL_IB_ADDR_RANGE=

NCCL_NET=IB
NCCL_IB_DISABLE=0
# NCCL >= 2.21 selects the RoCE v2 GID dynamically. Do not set
# NCCL_IB_GID_INDEX unless an older runtime explicitly requires it.
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ADDR_RANGE=10.10.10.0/24
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN

# Optional NCCL fabric experiments (docs/OPTIMIZATION.md). Leave commented to
# keep the stock NCCL behavior validated by this recipe.
# Merge both fabric rails into one logical link (requires listing both HCAs,
# e.g. NCCL_IB_HCA=rocep1s0f1,rocep1s0f2). Measured +60% comm bandwidth.
# NCCL_IB_MERGE_NICS=1
# More queue pairs per connection can improve bandwidth on RoCE.
# NCCL_IB_QPS_PER_CONNECTION=4
# GPUDirect RDMA level. SYS allows GDR even across the PCIe root complex.
# NCCL_NET_GDR_LEVEL=SYS
# NCCL_DMABUF_ENABLE=1

# -----------------------------------------------------------------------------
# Checkpoint and immutable runtime pins (verified 2026-08-27).
# -----------------------------------------------------------------------------
MODEL_ID=LibertAIDAI/GLM-5.3-Flash-NVFP4
MODEL_REVISION=f4aa9ef9b180d608b924fade8983dca18b9bcdf7
SERVED_MODEL_NAME=glm-5.3-flash-nvfp4

# SGLang image patched and acceptance-tested on 2x GB10. The official vLLM
# day-0 image is deliberately rejected because its NoPE path is incorrect on
# sm_121. Source: https://github.com/0xSero/glm-5.3-flash-sglang-sm121
GLM53_RUNTIME_IMAGE=ghcr.io/0xsero/glm-5.3-flash-sglang-sm121@sha256:f9ac60ba4071f8acd64f0f3c074aca308f6d659405fee46fc8031489a1e8b19b

# -----------------------------------------------------------------------------
# Caches / download
# Each TP rank needs a complete local copy of the ~181.3 GiB checkpoint.
# -----------------------------------------------------------------------------
HF_CACHE=${HOME}/.cache/huggingface
# Set explicitly when the worker uses another user or filesystem.
WORKER_HF_CACHE=
# The checkpoint is public. Only set a token if your environment requires one.
# HF_TOKEN=hf_xxx
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
HF_HUB_DOWNLOAD_TIMEOUT=1800
HF_HUB_ETAG_TIMEOUT=60
HF_DOWNLOAD_WORKERS=4

# -----------------------------------------------------------------------------
# Serving profile
# The positional argument to start/validate overrides GLM53_PROFILE.
# Available profiles: 32k, 32k-batch4, 32k-batch8, 64k, 128k, 128k-batch4,
# 128k-batch4-8k, 128k-batch4-mtp, 128k-batch4-mtp3, 128k-batch2-mtp,
# 128k-batch8, 128k-ep1, 128k-mtp-ep1, 128k-mtp-compile, 256k, 256k-graphs,
# 256k-mtp, 384k-quality, 512k-mtp-eager, 512k-mtp-cp, 32k-mtp, 32k-eager.
# The batched profiles accept concurrent requests (sub-agents); the 128k
# profiles use 131 072 tokens. See docs/OPTIMIZATION.md for each experiment.
# -----------------------------------------------------------------------------
GLM53_PROFILE=32k
API_HOST=0.0.0.0
# Address shown to LAN clients such as OpenCode. This does not change the
# private RoCE fabric used between ranks.
API_ADVERTISE_HOST=management-ip-of-head
API_PORT=8888
# Optional SGLang bearer token. Quote values containing shell-special characters.
# API_KEY=change-me

# Leave enough unified memory for the OS. memswap_limit is set to the same value.
CONTAINER_MEMORY_LIMIT=120g
RESTART_POLICY=no
STOP_GRACE_PERIOD=30s

# Model init can take many minutes (download is deliberately forbidden at boot).
START_WAIT_TIMEOUT=3600
START_WAIT_INTERVAL=15
START_SMOKE=1

# Host-side load guard. It stops only this recipe's local container if available
# RAM falls below the threshold before the tokenizer/engine becomes usable.
OOM_GUARD=1
OOM_GUARD_MIN_AVAILABLE_MB=6144
OOM_GUARD_TIMEOUT=3600

# Doctor thresholds. Set REQUIRE_SWAP_OFF=1 for a strict no-swap policy.
MIN_START_AVAILABLE_MB=112000
MIN_CACHE_FREE_GIB=205
REQUIRE_SWAP_OFF=0
ALLOW_UNSUPPORTED_PLATFORM=0
# Set to 1 only when the kernel's unconstrained route must match the explicitly
# bound NCCL/Gloo/TP interface. Keep 0 for validated dual-link Spark fabrics.
STRICT_FABRIC_ROUTE=0

# -----------------------------------------------------------------------------
# Optional optimization experiments (docs/OPTIMIZATION.md).
# Every default below reproduces the validated recipe behavior exactly. Set a
# value either here or in a dedicated profiles/<name>.env file, then measure
# with ./bench-glm53.py before adopting it.
# -----------------------------------------------------------------------------
# 1 = pure tensor parallel: one all-reduce per MoE layer instead of the
#     expert-parallel all-to-all over RoCE. Identical output, different comm.
# EP_SIZE=2
# 1 = torch.compile on the decode path; longer boot, lossless numerics.
# ENABLE_TORCH_COMPILE=0
# TORCH_COMPILE_MAX_BS=4
# 1 = mix prefill chunks into decode batches. Requires MTP_NUM_TOKENS=0.
# ENABLE_MIXED_CHUNK=0
# Raise to lower KV-eviction aggressiveness if logs show retracts.
# SCHEDULE_CONSERVATIVENESS=1.0
# 1 = split long DSA prefills across both TP ranks. The fast >256k profile uses
#     attn CP=2/interleave to keep each rank below the 262k decode-graph replay
#     boundary. This changes only execution order, not model weights or tokens.
# ENABLE_PREFILL_CP=0
# ATTN_CP_SIZE=1
# CP_STRATEGY=interleave
